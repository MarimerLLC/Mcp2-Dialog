{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System.Net.Http": "Warning",
        "Yarp": "Warning",
        "Yarp.ReverseProxy.Forwarder.HttpForwarder": "Error"
      }
    }
  },
  "Otlp": {
    "Enabled": true,
    "Endpoint": "http://localhost:4327"
  },
  "Gateway": {
    "RetryOnConnectFailure": true,
    "RateLimit": {
      "Enabled": false,
      "PermitLimit": 3,
      "Window": "00:00:10"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "mcp": {
        "ClusterId": "mcp-servers",
        "RateLimiterPolicy": "per-tool",
        "Match": { "Path": "/mcp/{**rest}" }
      }
    },
    "Clusters": {
      "mcp-servers": {
        "LoadBalancingPolicy": "RoundRobin",
        "SessionAffinity": { "Enabled": false },
        "HealthCheck": {
          "Passive": { "Enabled": true, "Policy": "ConnectFailure", "ReactivationPeriod": "00:00:10" }
        },
        "Destinations": {
          "server-a": { "Address": "http://127.0.0.1:5201" },
          "server-b": { "Address": "http://127.0.0.1:5202" }
        }
      }
    }
  },
  "AllowedHosts": "*"
}
